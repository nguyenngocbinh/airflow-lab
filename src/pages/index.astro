---
import BaseLayout from '../layouts/BaseLayout.astro';
const experiments = [
  ['EXP-001','Installation','Windows + Docker + WSL2','Completed','/airflow-lab/experiments/001-installation/'],
  ['EXP-002','Hello World DAG','The smallest useful DAG','Next','/airflow-lab/#roadmap'],
  ['EXP-003','Task Dependency','A → B → C orchestration','Next','/airflow-lab/#roadmap'],
  ['EXP-004','Python Task','Execute Python in a worker','Next','/airflow-lab/#roadmap'],
  ['EXP-005','SQL Task','Run database work from Airflow','Next','/airflow-lab/#roadmap'],
  ['EXP-006','Jinja','Dynamic dates and parameters','Next','/airflow-lab/#roadmap'],
];
---
<BaseLayout title="Airflow Lab">
  <section class="hero">
    <div>
      <div class="eyebrow">Engineering notebook / Apache Airflow</div>
      <h1>Learn by<br/><span style="color:var(--accent)">breaking things.</span></h1>
      <p>A practical lab for Airflow experiments, failures, debugging, ETL orchestration and eventually ML / PD pipelines.</p>
      <div class="cta">
        <a class="btn primary" href="#experiments">Start experiments ↓</a>
        <a class="btn" href="/airflow-lab/experiments/001-installation/">Read EXP-001</a>
      </div>
    </div>
    <div class="terminal">
      <div class="dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
      <div><span class="dim">airflow-lab $</span> docker compose ps</div>
      <div class="prompt">✔ airflow-apiserver healthy</div>
      <div class="prompt">✔ airflow-scheduler healthy</div>
      <div class="prompt">✔ airflow-worker healthy</div>
      <div class="prompt">✔ postgres healthy</div>
      <div class="prompt">✔ redis healthy</div>
      <br/>
      <div><span class="dim">airflow-lab $</span> docker run ... airflow version</div>
      <div>3.3.2</div>
    </div>
  </section>

  <section class="stats">
    <div class="stat"><strong>3.3.2</strong><span>Airflow</span></div>
    <div class="stat"><strong>7</strong><span>services</span></div>
    <div class="stat"><strong>1</strong><span>live lab</span></div>
    <div class="stat"><strong>∞</strong><span>experiments</span></div>
  </section>

  <section id="architecture" class="section">
    <div class="eyebrow">01 / Architecture</div>
    <h2>From Windows to an Airflow cluster in Docker</h2>
    <p class="section-intro">The local setup uses Docker Desktop + WSL2 and runs the Airflow control plane, worker, PostgreSQL metadata database and Redis broker as separate containers.</p>
    <div class="architecture">
      <div class="flow">
        <div class="node">Windows</div><div class="arrow">→</div>
        <div class="node">Docker Desktop</div><div class="arrow">→</div>
        <div class="node">WSL2</div><div class="arrow">→</div>
        <div class="node">Airflow</div>
      </div>
      <div style="height:18px"></div>
      <div class="flow">
        <div class="node">API Server</div><div class="arrow">↔</div>
        <div class="node">Scheduler</div><div class="arrow">→</div>
        <div class="node">Worker</div>
      </div>
      <div style="height:18px"></div>
      <div class="flow">
        <div class="node">DAG Processor</div><div class="arrow">+</div>
        <div class="node">Triggerer</div><div class="arrow">+</div>
        <div class="node">PostgreSQL</div><div class="arrow">+</div>
        <div class="node">Redis</div>
      </div>
    </div>
  </section>

  <section id="experiments" class="section">
    <div class="eyebrow">02 / Experiments</div>
    <h2>One question. One experiment.</h2>
    <p class="section-intro">Each experiment records the objective, commands, evidence, failure modes, solution and lessons learned.</p>
    <div class="grid">
      {experiments.map(([id,title,desc,status,href]) => (
        <article class="card">
          <span class="tag">{id}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
          <a href={href}>[{status === 'Completed' ? 'read experiment →' : 'planned →'}]</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">03 / Real pipeline</div>
    <h2>From scheduled SQL to model orchestration</h2>
    <div class="architecture">
      <div class="flow">
        <div class="node">DB2 / MSSQL</div><div class="arrow">→</div>
        <div class="node">Extract</div><div class="arrow">→</div>
        <div class="node">Feature</div><div class="arrow">→</div>
        <div class="node">Validation</div><div class="arrow">→</div>
        <div class="node">PD Model</div><div class="arrow">→</div>
        <div class="node">Data Mart</div>
      </div>
    </div>
    <div class="callout">The lab will gradually move from simple DAG mechanics to realistic ETL and credit-risk / PD orchestration patterns.</div>
  </section>

  <section id="roadmap" class="section">
    <div class="eyebrow">04 / Roadmap</div>
    <h2>Learning path</h2>
    <div class="two">
      <div class="card"><h3>Fundamentals</h3><p>DAG → Task → Dependency → Scheduler → Worker → Triggerer</p></div>
      <div class="card"><h3>Reliability</h3><p>Retry → Timeout → Failure handling → Logging → Monitoring</p></div>
      <div class="card"><h3>Data Engineering</h3><p>SQL → Python → Connections → Jinja → XCom → ETL</p></div>
      <div class="card"><h3>ML / Risk</h3><p>Features → Validation → PD scoring → Post-processing → Data Mart</p></div>
    </div>
  </section>
</BaseLayout>